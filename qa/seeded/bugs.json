  {
    "id": "inline-html",
    "difficulty": "easy",
    "category": "xss",
    "severity": "low",
    "tests": "tests/api.test.ts",
    "description": "uploaded HTML and SVG are served inline from the app's origin",
    "patches": [
      {
        "file": "src/routes/files.ts",
