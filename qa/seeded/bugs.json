  },
  {
    "id": "download-read-perm",
    "difficulty": "subtle",
    "category": "authz",
    "severity": "high",
    "tests": "tests/api.test.ts",
    "description": "downloading a file only needs the read permission, so someone allowed to list but not download (a visitor by default setting, or a read-only user) gets the files",
    "patches": [
      {
        "file": "src/routes/files.ts",
        "find": "need({ user, ip }, query.space, 'download')",
        "replace": "need({ user, ip }, query.space, 'read')"
      }
    ]
  }
]
