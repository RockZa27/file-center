  {
    "id": "rename-read-perm",
    "category": "authz",
    "severity": "high",
    "tests": "tests/api.test.ts",
    "description": "renaming only needs the read permission, so a read-only user (or visitor) can rename files",
    "patches": [
      {
        "file": "src/routes/files.ts",
        "find": "const a = need({ user, ip }, body.space, 'write')\n    const rel = normRel(body.path)\n    if (rel === '/') throw bad('ไม่สามารถเปลี่ยนชื่อโฟลเดอร์หลักได้')",
        "replace": "const a = need({ user, ip }, body.space, 'read')\n    const rel = normRel(body.path)\n    if (rel === '/') throw bad('ไม่สามารถเปลี่ยนชื่อโฟลเดอร์หลักได้')"
      }
    ],
    "difficulty": "subtle"
  },
  {
    "id": "must-change-scope",
