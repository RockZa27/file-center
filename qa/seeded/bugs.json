    "difficulty": "subtle"
  },
  {
    "id": "session-never-expires",
    "category": "auth",
    "severity": "medium",
    "tests": "tests/api.test.ts",
    "description": "sessions are measured from creation in milliseconds against a TTL multiplied by 1000, so they practically never expire",
    "patches": [
      {
        "file": "src/auth.ts",
        "find": "if (Date.now() - s.seen > ttlOf(s)) {",
        "replace": "if (Date.now() - s.created > ttlOf(s) * 1000) {"
      }
    ],
    "difficulty": "subtle"
  },
  {
    "id": "guest-all-perms",
    "category": "authz",
    "severity": "high",
    "tests": "tests/api.test.ts",
    "description": "visitors get every permission in the public folder instead of the ones the admin chose",
    "patches": [
      {
        "file": "src/auth.ts",
        "find": "return { space, root: paths.publicDir, perms: new Set(settings.get().guestPermissions) }",
        "replace": "return { space, root: paths.publicDir, perms: new Set(PERMISSIONS) }"
      }
    ],
    "difficulty": "subtle"
  },
  {
    "id": "xff-first-entry",
    "category": "auth",
    "severity": "medium",
    "tests": "tests/api.test.ts",
    "description": "behind a reverse proxy the client-supplied first X-Forwarded-For entry is trusted, so the login lockout can be dodged by changing it",
    "patches": [
      {
        "file": "src/context.ts",
        "find": "split(',').at(-1)?.trim()",
        "replace": "split(',').at(0)?.trim()"
      }
    ],
    "difficulty": "subtle"
  },
  {
    "id": "lockout-case",
    "category": "auth",
    "severity": "medium",
    "tests": "tests/api.test.ts",
    "description": "the lockout key keeps the username's case while login ignores it, so ADMIN / Admin / admin each get their own attempts",
    "patches": [
      {
        "file": "src/routes/session.ts",
        "find": "const key = `${ip}|${username.toLowerCase()}`",
        "replace": "const key = `${ip}|${username}`"
      }
    ],
    "difficulty": "subtle"
  },
  {
    "id": "homedir-in-public",
    "category": "authz",
