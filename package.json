{
  "name": "file-center",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"bun --watch src/index.ts\" \"vite --config web/vite.config.js\"",
    "dev:api": "bun --watch src/index.ts",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "bun src/launcher.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "package": "bun scripts/package.ts",
    "release": "bun scripts/release.ts",
    "bench": "bun scripts/bench.ts",
    "qa": "bun scripts/qa/run-checks.ts",
    "qa:seed": "bun scripts/qa/seed.ts check",
    "qa:score": "bun scripts/qa/score.ts"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.23.0",
    "elysia": "^1.4.30",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource/ibm-plex-sans-thai": "^5.2.0",
    "@lezer/highlight": "1.2.5",
    "@types/bun": "latest",
    "@vicons/ionicons5": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.0.0",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.17",
    "fflate": "^0.8.2",
    "marked": "18.1.1",
    "naive-ui": "^2.41.0",
    "pinia": "^3.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.5.0"
  }
}
